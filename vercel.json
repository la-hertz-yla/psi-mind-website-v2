{
  "rewrites": [
    { "source": "/src/css/(.*)", "destination": "/src/css/$1" },
    { "source": "/src/js/(.*)", "destination": "/src/js/$1" },
    { "source": "/src/img/(.*)", "destination": "/src/img/$1" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/(.*\\.html)", "destination": "/src/HTML/$1" },
    { "source": "/((?!src/).*)", "destination": "/src/HTML/index.html" }
  ]
}